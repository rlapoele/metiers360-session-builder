{
  "name": "metiers360-session-builder",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "astro dev --ignore-lock",
    "dev:api": "npm --prefix server start",
    "start": "node ./dist/server/entry.mjs",
    "start:web": "node ./dist/server/entry.mjs",
    "start:api": "npm --prefix server start",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"{src,e2e}/**/*.{astro,css,ts,tsx}\" \"*.{js,mjs,json,ts}\" \"server/package.json\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{astro,css,ts,tsx}\" \"*.{js,mjs,json,ts}\" \"server/package.json\"",
    "test": "vitest run --passWithNoTests",
    "test:browser": "playwright test",
    "build": "astro build",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@base-ui/react": "^1.9.0",
    "@heroicons/react": "^2.2.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "nanostores": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
