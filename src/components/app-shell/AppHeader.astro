---
import { getNavigationItems } from '@components/app-shell/navigation';
import { SessionDraftButton } from '@components/app-shell/SessionDraftButton';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigationItems = getNavigationItems(currentPath);
---

<header class="border-border bg-card border-b">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center px-4 sm:min-h-20 sm:flex-nowrap sm:gap-8 sm:px-6 lg:px-8">
    <a
      href="/"
      class="focus-visible:outline-ring order-1 flex min-h-16 items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 sm:min-h-0"
    >
      <img
        src="/images/m360-logo.webp"
        width="192"
        height="192"
        alt="Métiers360"
        class="size-12"
      />
    </a>

    <nav
      aria-label="Navigation principale"
      class="border-border order-3 flex basis-full border-t sm:order-2 sm:basis-auto sm:border-t-0"
    >
      {navigationItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.isCurrent ? 'page' : undefined}
          class:list={[
            'focus-visible:outline-ring relative flex min-h-12 items-center px-3 text-base font-medium focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-2 sm:min-h-20 sm:px-2',
            item.isCurrent
              ? 'text-navigation-current after:bg-primary after:absolute after:inset-x-3 after:bottom-0 after:h-1 sm:after:inset-x-2'
              : 'text-muted-foreground hover:text-foreground hover:bg-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <SessionDraftButton client:only="react" currentPath={currentPath}>
      <div
        slot="fallback"
        role="status"
        aria-label="Chargement de ma séance"
        class="border-border text-muted-foreground order-2 ml-auto inline-flex min-h-11 items-center gap-2 rounded-md border px-3 text-sm font-medium sm:order-3"
      >
        Ma séance
        <span
          aria-hidden="true"
          class="bg-muted inline-flex size-6 animate-pulse rounded-full"
        ></span>
      </div>
    </SessionDraftButton>
  </div>
</header>
