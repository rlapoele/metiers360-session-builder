---
import AppLayout from '../layouts/AppLayout.astro';
import { CatalogueApp } from '../components/catalogue/CatalogueApp';
import type { CatalogueReferences } from '../features/catalogue/api';
import {
  catalogueQueryFromSearchParams,
  catalogueQueryToSearchParams,
} from '../features/catalogue/query-params';
import { getCatalogueClient } from '../lib/api/catalogue-client-instance.server';

const initialQuery = catalogueQueryFromSearchParams(Astro.url.searchParams);
const client = getCatalogueClient();
const [videosResult, referencesResult] = await Promise.allSettled([
  client.listVideos(catalogueQueryToSearchParams(initialQuery)),
  Promise.all([
    client.listJobs(),
    client.listHeadsets(),
    client.listAudiences(),
  ]),
]);
const initialVideos =
  videosResult.status === 'fulfilled' ? videosResult.value : undefined;
const initialReferences: CatalogueReferences | undefined =
  referencesResult.status === 'fulfilled'
    ? {
        jobs: referencesResult.value[0],
        headsets: referencesResult.value[1],
        audiences: referencesResult.value[2],
      }
    : undefined;
---

<AppLayout
  title="Catalogue des vidéos"
  description="Trouvez les vidéos immersives adaptées à votre prochaine séance de découverte des métiers."
>
  <section aria-labelledby="catalogue-title" class="max-w-2xl">
    <h1
      id="catalogue-title"
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Catalogue des vidéos
    </h1>
    <p class="text-muted-foreground mt-4 text-base leading-7 sm:text-lg">
      Trouvez les contenus adaptés à votre prochaine séance.
    </p>
  </section>

  <section aria-label="Recherche dans le catalogue" class="mt-8 sm:mt-10">
    <CatalogueApp
      client:load
      initialQuery={initialQuery}
      initialVideos={initialVideos}
      initialReferences={initialReferences}
    />
  </section>
</AppLayout>
