---
import AppLayout from '@layouts/AppLayout.astro';
import { CatalogueApp } from '@components/catalogue/CatalogueApp';
import { getCatalogueSearchService } from '@features/catalogue/search-http.server';
import type { CataloguePageResult } from '@features/catalogue/search-contracts';

const initialSearch = Astro.url.searchParams.toString();
const initialResult: CataloguePageResult = getCatalogueSearchService().page(
  Astro.url.searchParams,
);
Astro.response.headers.set('Cache-Control', 'no-store');
if (initialResult.status !== 200) {
  Astro.response.status = initialResult.status;
  if (initialResult.status === 503 && initialResult.retryAfter)
    Astro.response.headers.set('Retry-After', '1');
} else {
  const requested = Number(Astro.url.searchParams.get('page') ?? 1);
  if (requested !== initialResult.body.meta.page) {
    const params = new URLSearchParams(Astro.url.searchParams);
    if (initialResult.body.meta.page === 1) params.delete('page');
    else params.set('page', String(initialResult.body.meta.page));
    const suffix = params.toString();
    return Astro.redirect(
      `${Astro.url.pathname}${suffix ? `?${suffix}` : ''}`,
      302,
    );
  }
}
---

<AppLayout
  title="Catalogue des vidéos"
  description="Trouvez les vidéos immersives adaptées à votre prochaine séance de découverte des métiers."
>
  <section aria-labelledby="catalogue-title" class="max-w-2xl">
    <h1
      id="catalogue-title"
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Catalogue des vidéos
    </h1>
    <p class="text-muted-foreground mt-3 text-base leading-7 sm:text-lg">
      Recherchez des vidéos et ajoutez-les à votre prochaine séance.
    </p>
  </section>

  <section aria-label="Recherche dans le catalogue" class="mt-6 sm:mt-8">
    <CatalogueApp
      client:load
      initialSearch={initialSearch}
      initialResult={initialResult}
    />
  </section>
</AppLayout>
