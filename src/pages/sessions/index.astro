---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout
  title="Mes séances"
  description="Retrouvez votre séance en préparation et les séances déjà enregistrées."
>
  <section aria-labelledby="sessions-title" class="max-w-2xl">
    <h1
      id="sessions-title"
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Mes séances
    </h1>
    <p class="text-muted-foreground mt-4 text-base leading-7 sm:text-lg">
      Retrouvez votre séance en préparation et les séances déjà enregistrées.
    </p>
  </section>
</AppLayout>
