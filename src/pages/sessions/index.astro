---
import { SessionsApp } from '../../components/sessions/SessionsApp';
import type { SessionsOverview } from '../../features/sessions/api';
import AppLayout from '../../layouts/AppLayout.astro';
import { getCatalogueClient } from '../../lib/api/catalogue-client-instance.server';

const createdSessionId = Astro.url.searchParams.get('created');
const safeCreatedSessionId =
  createdSessionId !== null && /^[A-Za-z0-9_-]+$/.test(createdSessionId);
const client = getCatalogueClient();
const overviewResult = await Promise.allSettled([
  client.listSessions(),
  client.listHeadsets(),
]);
const initialOverview: SessionsOverview | undefined =
  overviewResult[0].status === 'fulfilled' &&
  overviewResult[1].status === 'fulfilled'
    ? {
        sessions: overviewResult[0].value,
        headsets: overviewResult[1].value,
      }
    : undefined;
---

<AppLayout
  title="Mes séances"
  description="Retrouvez votre séance en préparation et les séances déjà enregistrées."
>
  <section aria-labelledby="sessions-title" class="max-w-3xl">
    <h1
      id="sessions-title"
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Mes séances
    </h1>
    <p class="text-muted-foreground mt-3 text-base leading-7 sm:text-lg">
      Retrouvez votre séance en préparation et les séances déjà enregistrées.
    </p>
  </section>

  <section aria-label="Séances" class="mt-6 sm:mt-8">
    <SessionsApp
      client:load
      initialOverview={initialOverview}
      createdSessionId={safeCreatedSessionId ? createdSessionId : undefined}
    />
  </section>
</AppLayout>
